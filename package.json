{
  "name": "amd-site-2026",
  "version": "0.0.1",
  "description": "Aluno Maker Digital — Plataforma de robótica educacional para escolas públicas",
  "private": true,
  "scripts": {
    "build:css": "cleancss -o assets/css/bundle.min.css assets/css/variables.css assets/css/main.css assets/css/animations.css assets/css/components.css assets/css/responsive.css",
    "css:watch": "node scripts/watch-css.js",
    "dev": "concurrently --names \"servidor,css,imagens,vídeos\" --prefix-colors \"cyan,magenta,green,yellow\" \"serve . -l 5500\" \"node scripts/watch-css.js\" \"node scripts/watch-images.js\" \"node scripts/watch-videos.js\"",
    "images:optimize": "node scripts/optimize-images.js",
    "images:watch": "node scripts/watch-images.js",
    "videos:optimize": "node scripts/optimize-videos.js",
    "videos:watch": "node scripts/watch-videos.js",
    "serve:lhci": "serve . -l 5500 --no-clipboard",
    "test": "playwright test",
    "test:ci": "playwright test --project=chromium",
    "lhci": "lhci autorun --config=tests/lighthouse/lighthouserc.json",
    "lint:js": "eslint \"assets/js/**/*.js\" --no-warn-ignored",
    "lint:css": "stylelint \"assets/css/**/*.css\" \"!assets/css/bundle.min.css\" --allow-empty-input",
    "lint": "npm run lint:js && npm run lint:css",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.60.0",
    "chokidar": "^5.0.0",
    "clean-css-cli": "^5.6.3",
    "concurrently": "^9.2.1",
    "eslint": "^10.4.0",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "serve": "^14.2.6",
    "sharp": "^0.34.5",
    "stylelint": "^17.11.1",
    "stylelint-config-standard": "^40.0.0"
  }
}
